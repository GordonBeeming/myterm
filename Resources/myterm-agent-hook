#!/bin/sh
# Hook stdout belongs to the agent's reply protocol, never to terminal activity.
fingerprint_field() {
  printf '%s' "$input" | /usr/bin/plutil -extract "$1" raw -expect string -n -o /dev/null - 2>/dev/null || return 1
  digest=$(printf '%s' "$input" | /usr/bin/plutil -extract "$1" raw -expect string -n -o - - 2>/dev/null | /usr/bin/shasum -a 256)
  printf '%s' "${digest%% *}"
}

report_agent() {
  [ -n "${MYTERM_PANE_ID:-}" ] || return 0
  agent=${1:-}
  activity=${2:-}
  [ "$activity" != awaitingInput ] || activity=awaiting_input
  case "$agent" in claude|codex|antigravity|grok) ;; *) return 0;; esac
  case "$activity" in ready|working|finished|awaiting_input|exited|status) ;; *) return 0;; esac
  # Grok also loads Claude's settings; only its dedicated MyTerm hooks report it.
  if [ -n "${GROK_HOOK_EVENT:-}" ] && [ "$agent" != grok ]; then return 0; fi
  captured=''
  if [ "$agent" = antigravity ]; then
    captured=${MYTERM_AGENT_CAPTURE_TIME:-}
    if [ "$activity" != status ] && [ -z "$captured" ]; then
      captured=$(/usr/bin/perl -MTime::HiRes=clock_gettime,CLOCK_MONOTONIC -e 'printf "%.9f", clock_gettime(CLOCK_MONOTONIC)')
    fi
    case "$captured" in *[!0-9.]*) captured='';; esac
  fi
  input=$(cat | tr -d '\n')
  title=''
  turn=''
  turn_start=''
  native_tool=''
  snapshot=''
  work_start=''
  tool_call=''
  if [ "$agent" = grok ] || [ "$agent" = antigravity ]; then
    input=$(printf '%s' "$input" | /usr/bin/osascript -l JavaScript "$MYTERM_RESOURCE_DIR/myterm-agent-normalize.js" "$agent" "$activity" "$captured") || return 0
    activity=$(printf '%s' "$input" | /usr/bin/plutil -extract activity raw -o - - 2>/dev/null) || return 0
    if [ "$agent" = antigravity ]; then
      captured=$(printf '%s' "$input" | /usr/bin/plutil -extract captured raw -o - - 2>/dev/null) || return 0
    fi
    case "$activity" in ready|working|finished|awaiting_input|exited|title) ;; *) return 0;; esac
    if raw_title=$(printf '%s' "$input" | /usr/bin/plutil -extract session_title raw -expect string -n -o - - 2>/dev/null); then
      title=$(printf '%s' "$raw_title" | /usr/bin/base64 | tr -d '\n')
    fi
    turn=$(fingerprint_field turn64) || turn=''
    tool_call=$(fingerprint_field tool_call64) || tool_call=''
    if [ "$(printf '%s' "$input" | /usr/bin/plutil -extract turn_start raw -o - - 2>/dev/null)" = true ]; then turn_start=1; fi
    native_tool=$(printf '%s' "$input" | /usr/bin/plutil -extract tool_key raw -expect string -o - - 2>/dev/null) || native_tool=''
    if [ "$(printf '%s' "$input" | /usr/bin/plutil -extract snapshot raw -o - - 2>/dev/null)" = true ]; then snapshot=1; fi
    if [ "$(printf '%s' "$input" | /usr/bin/plutil -extract work_start raw -o - - 2>/dev/null)" = true ]; then work_start=1; fi
  fi
  # An idle Claude prompt is not a question. Keep filtering in the shipped script
  # so changes don't alter the hook definitions users have already trusted.
  if [ "$agent" = claude ] && [ "$activity" = awaiting_input ]; then
    case "$input" in *'waiting for your input'*) return 0;; esac
  fi
  if subagent=$(printf '%s' "$input" | /usr/bin/plutil -extract agent_id raw -expect string -o - - 2>/dev/null); then
    [ -z "$subagent" ] || return 0
  fi
  # Only ancestors on this TTY identify a nested agent. MyTerm itself may have
  # been launched from another agent's terminal.
  agent_owner_pid=''
  if [ "$agent" = antigravity ]; then
    case "${MYTERM_AGENT_OWNER_PID:-}" in ''|*[!0-9]*|0|1) ;; *) agent_owner_pid=$MYTERM_AGENT_OWNER_PID;; esac
  fi
  pid=${agent_owner_pid:-$PPID}
  depth=0
  owner_tty=''
  owner_command=''
  found_agent=false
  while [ "$depth" -lt 16 ]; do
    info=$(ps -o ppid= -o tty= -o comm= -p "$pid" 2>/dev/null)
    read -r parent process_tty command <<EOF
$info
EOF
    [ -n "$process_tty" ] || break
    [ "$depth" -ne 0 ] || owner_command=$command
    case "$process_tty" in
      '??'|'?'|'-') [ -z "$owner_tty" ] || break;;
      *)
        [ -n "$owner_tty" ] || owner_tty=$process_tty
        [ "$process_tty" = "$owner_tty" ] || break
        ;;
    esac
    case "${command##*/}" in
      claude|codex|codex-statusline|agy|antigravity|grok|grok-macos-aarch|grok-macos-aarch64|grok-macos-x86_64)
        [ "$found_agent" = false ] || return 0
        found_agent=true
        owner_command=$command
        ;;
    esac
    case "$parent" in ''|*[!0-9]*|0|1) break;; esac
    pid=$parent
    depth=$((depth + 1))
  done
  if [ -n "$agent_owner_pid" ] && [ "$found_agent" = false ]; then return 0; fi
  # The sentinel preserves trailing newlines so validation rejects them.
  session=$(printf '%s' "$input" | /usr/bin/plutil -extract session_id raw -expect string -n -o - - 2>/dev/null; printf '.')
  session=${session%.}
  case "$session" in ''|*[!A-Za-z0-9._-]*) session='';; esac
  [ "${#session}" -le 64 ] || session=''
  cwd=''
  if raw_cwd=$(printf '%s' "$input" | /usr/bin/plutil -extract cwd raw -expect string -n -o - - 2>/dev/null && printf '.'); then
    raw_cwd=${raw_cwd%.}
    cwd=$(printf '%s' "$raw_cwd" | /usr/bin/base64 | tr -d '\n')
  fi
  launcher=''
  tool=''
  if [ -n "$native_tool" ]; then
    tool=$(printf '%s' "$native_tool" | /usr/bin/shasum -a 256)
    tool=${tool%% *}
  fi
  if [ "$agent" = codex ]; then
    # Canonical JSON also supports null arguments, which property-list XML cannot
    # represent. Read through stdin rather than exposing tool arguments in argv.
    if tool_name=$(printf '%s' "$input" | /usr/bin/plutil -extract tool_name raw -expect string -n -o - - 2>/dev/null) &&
       tool_input=$(printf '%s' "$input" | /usr/bin/plutil -extract tool_input json -o - - 2>/dev/null |
         /usr/bin/osascript -l JavaScript -e '
           ObjC.import("Foundation");
           function sorted(value) {
             if (Array.isArray(value)) return value.map(sorted);
             if (value === null || typeof value !== "object") return value;
             var result = Object.create(null);
             Object.keys(value).sort().forEach(function (key) { result[key] = sorted(value[key]); });
             return result;
           }
           function run() {
             var data = $.NSFileHandle.fileHandleWithStandardInput.readDataToEndOfFile;
             var text = ObjC.unwrap($.NSString.alloc.initWithDataEncoding(data, $.NSUTF8StringEncoding));
             var input = JSON.parse(text);
             // Shell approval callbacks can add a description absent from tool completion.
             if (input && typeof input.command === "string") input = { command: input.command };
             return JSON.stringify(sorted(input));
           }'); then
      tool=$(printf '%s\n%s' "$tool_name" "$tool_input" | /usr/bin/shasum -a 256)
      tool=${tool%% *}
    fi
    case "${MYTERM_CODEX_LAUNCHER:-}" in codex|codex-statusline) launcher=$MYTERM_CODEX_LAUNCHER;; esac
    if [ -z "$launcher" ]; then
      case "$owner_command" in
        */.local/share/codex-statusline/current/bin/codex|*/.local/share/codex-statusline/releases/*/bin/codex) launcher=codex-statusline;;
        *) case "${owner_command##*/}" in codex|codex-statusline) launcher=${owner_command##*/};; esac;;
      esac
    fi
  fi
  # The Claude account: unset means the standard sign-in, a set CLAUDE_CONFIG_DIR (direnv and the
  # like) names another. Only a set variable puts a path in the marker.
  config=''
  config_dir=''
  if [ "$agent" = claude ]; then
    if [ -n "${CLAUDE_CONFIG_DIR:-}" ]; then
      config_dir=$(printf '%s' "$CLAUDE_CONFIG_DIR" | /usr/bin/base64 | tr -d '\n')
    else
      config=default
    fi
  fi
  tty=$(ps -o tty= -p "${agent_owner_pid:-$PPID}" 2>/dev/null | tr -d '[:space:]')
  case "$tty" in ''|'??'|'?'|'-') tty=$owner_tty;; esac
  case "$tty" in *[0-9]*) tty="/dev/${tty#/dev/}";; *) tty=/dev/tty;; esac
  [ "$activity" != title ] || return 0
  printf '\033]7337;agent=%s;event=%s;session=%s;cwd64=%s;launcher=%s;tool=%s;title64=%s;turn=%s;turn_start=%s;snapshot=%s;work_start=%s;call=%s;captured=%s;config=%s;config64=%s\033\134' \
    "$agent" "$activity" "$session" "$cwd" "$launcher" "$tool" "$title" "$turn" "$turn_start" "$snapshot" "$work_start" "$tool_call" "$captured" "$config" "$config_dir" > "$tty"
}
report_agent "$@" >/dev/null 2>&1 || true
if [ "${1:-}" = antigravity ] && [ "${2:-}" != status ]; then
  case "${2:-}" in
    awaitingInput|awaiting_input) printf '{"decision":"allow"}\n';;
    *) printf '{}\n';;
  esac
fi
