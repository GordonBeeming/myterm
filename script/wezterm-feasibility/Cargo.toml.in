[package]
name = "myterm-wezterm-feasibility-prototype"
version = "0.0.0"
edition = "2021"

[dependencies]
anyhow = "1"
serde = { version = "1", features = ["derive"] }
serde_json = "1"
wezterm-term = { path = "@WEZTERM_SOURCE@/term" }

[[bin]]
name = "wezterm-feasibility"
path = "@PROTOTYPE_SOURCE@/main.rs"
