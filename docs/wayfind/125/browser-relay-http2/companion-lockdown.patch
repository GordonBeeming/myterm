+        let udp = try BrowserUDPProbe()
+        let udpPort = try await udp.start()
+        defer { udp.stop() }
+        let bridge = EncryptedBrowserBridge()
+        await bridge.configure(destinationPort: port)
+        let browser = NativeRemoteBrowser()
+        registerCleanup(browser, bridge: bridge)
+        let endpoint = try await bridge.endpoint()
+        try await startRemoteFixture(browser, endpoint: endpoint,
+                                     url: try XCTUnwrap(URL(string: "http://myterm-test.invalid/page")))
+        let proxiedView = try XCTUnwrap(browser.webView)
+        try await waitForBrowser { proxiedView.title == "Remote fixture" && !proxiedView.isLoading }
+
+        let configuration = WKWebViewConfiguration()
+        configuration.websiteDataStore = .nonPersistent()
+        configuration.websiteDataStore.proxyConfigurations = proxiedView.configuration.websiteDataStore.proxyConfigurations
+        let ordinaryView = WKWebView(frame: .zero, configuration: configuration)
+        let url = try XCTUnwrap(URL(string: "http://myterm-test.invalid/control"))
+        ordinaryView.load(URLRequest(url: url))
+        try await waitForBrowser { ordinaryView.title == "Remote fixture" && !ordinaryView.isLoading }
+        let state = try await ordinaryView.evaluateJavaScript(Self.webRTCProbe(udpPort: udpPort, includeFrame: false))
+        XCTAssertEqual(state as? [String], ["gathering"])
+        try await waitForBrowser { udp.count > 0 }
+        print("WEBRTC_BOUNDARY_CONTROL: ordinary proxied view emitted \(udp.count) client-local UDP datagram(s)")
+        _ = try await ordinaryView.evaluateJavaScript("window.mytermRTCProbe?.close()")
         browser.stop()
         await bridge.stop()
     }
 
+    private func assertWebRTCDisabled(in view: WKWebView, udpPort: UInt16) async throws {
+        let state = try await view.evaluateJavaScript(Self.webRTCProbe(udpPort: udpPort, includeFrame: true))
+        XCTAssertEqual(state as? [String], ["unavailable", "unavailable"],
+                       "Both the loaded page and the loaded embedded frame must disable WebRTC")
+    }
+
+    private static func webRTCProbe(udpPort: UInt16, includeFrame: Bool) -> String {
+        """
+        (() => {
+          const probe = scope => {
+            const PeerConnection = scope.RTCPeerConnection ?? scope.webkitRTCPeerConnection;
+            if (typeof PeerConnection === 'undefined') return 'unavailable';
+            const pc = new PeerConnection({iceServers:[{urls:'stun:127.0.0.1:\(udpPort)'}]});
+            scope.mytermRTCProbe = pc;
+            pc.createDataChannel('fixture');
+            pc.createOffer().then(offer => pc.setLocalDescription(offer))
+              .catch(error => scope.mytermRTCError = String(error));
+            return 'gathering';
+          };
+          const results = [probe(window)];
+          if (\(includeFrame)) {
+            const frame = document.getElementById('rtc-frame')?.contentWindow;
+            results.push(frame?.rtcFixtureReady ? probe(frame) : 'frame not loaded');
+          }
+          return results;
+        })()
+        """
+    }
