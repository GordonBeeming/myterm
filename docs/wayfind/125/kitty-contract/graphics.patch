+impl KittyImageState {
+    pub(super) fn prototype_relative_hashes(&self) -> Vec<[u8; 32]> {
+        self.prototype_relative_data
+            .values()
+            .map(|(image, _, _)| image.hash())
+            .collect()
+    }
+    pub(super) fn prototype_relative_resources(
+        &self,
+        graphics: &mut BridgeGraphics,
+        cell_height: usize,
+    ) -> anyhow::Result<Vec<serde_json::Value>> {
+        let mut result = Vec::new();
+        let mut raster_cost = 0usize;
+        for (key, (image, width, height)) in &self.prototype_relative_data {
+            raster_cost = raster_cost
+                .checked_add(width * height * 4 + height.div_ceil(cell_height) * 4096)
+                .ok_or_else(|| anyhow::anyhow!("relative raster budget overflow"))?;
+            anyhow::ensure!(raster_cost <= 2_097_152, "Kitty relative raster byte limit");
+            let request = self
+                .prototype_requests
+                .get(key)
+                .ok_or_else(|| anyhow::anyhow!("missing relative request identity"))?;
+            let resource = graphics.relative_resource(image, *width, *height, request)?;
+            result.push(serde_json::json!({"id":key.0,"placement":key.1,"resource":resource}));
+        }
+        result.sort_by_key(|r| (r["id"].as_u64(), r["placement"].as_u64()));
+        Ok(result)
+    }
+}
