+impl TerminalState {
+    fn prototype_virtual_position(&self, key: (u32,Option<u32>)) -> Option<(i64,i64)> {
+        fn color(c: crate::color::ColorAttribute) -> u32 {
+            use crate::color::ColorAttribute::*;
+            match c {
+                Default => 0, PaletteIndex(i) => i as u32,
+                TrueColorWithPaletteFallback(c,_) | TrueColorWithDefaultFallback(c) => {
+                    let (r,g,b,_) = c.to_srgb_u8(); ((r as u32)<<16) | ((g as u32)<<8) | b as u32
+                }
+            }
+        }
+        let mut result: Option<(i64,i64)> = None;
+        for (row,line) in self.screen().lines_in_phys_range(0..self.screen().scrollback_rows()).iter().enumerate() {
+            let mut previous: Option<(usize,usize,usize,u32,u32,u32)> = None;
+            for cell in line.visible_cells() {
+                let col = cell.cell_index();
+                if col >= self.screen().physical_cols { break; }
+                let mut chars = cell.str().chars();
+                if chars.next() != Some('\u{10eeee}') { previous=None;continue; }
+                let marks: Vec<_> = chars.filter_map(|c|PROTOTYPE_KITTY_DIACRITICS.iter().position(|v|*v == c as u32)).collect();
+                let fg = color(cell.attrs().foreground()); let ul = color(cell.attrs().underline_color());
+                let adjacent = previous.filter(|p|p.0+1 == col && p.4 == fg && p.5 == ul);
+                let pr = marks.first().copied().unwrap_or_else(||adjacent.map_or(0,|p|p.1));
+                let pc = marks.get(1).copied().unwrap_or_else(||adjacent.filter(|p|p.1 == pr).map_or(0,|p|p.2+1));
+                let msb = marks.get(2).copied().map(|n|n.min(255) as u32).unwrap_or_else(||
+                    adjacent.filter(|p|p.1 == pr && (marks.len()<2 || p.2+1 == pc)).map_or(0,|p|p.3));
+                previous=Some((col,pr,pc,msb,fg,ul));
+                if fg | (msb<<24) == key.0 && (ul == 0 || Some(ul) == key.1) {
+                    result = Some((result.map_or(row as i64,|v|v.0.min(row as i64)),result.map_or(col as i64,|v|v.1.min(col as i64))));
+                }
+            }
+        }
+        result
+    }
