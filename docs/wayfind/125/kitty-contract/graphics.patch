+impl BridgeGraphics {
+    fn request_key(
+        hash: [u8; 32],
+        width: usize,
+        height: usize,
+        request: Option<&BridgeValue>,
+    ) -> anyhow::Result<String> {
+        let encoded = serde_json::to_vec(&request)?;
+        let request_hash = wezterm_cell::image::ImageDataType::hash_bytes(&encoded);
+        Ok(format!(
+            "{}-{}-{}-{}",
+            hex::encode(hash),
+            width,
+            height,
+            hex::encode(request_hash)
+        ))
+    }
+}
