+impl TerminalState {
+    fn prototype_delete_selection(&mut self, what: KittyImageDelete) {
+        let history = self.screen().scrollback_rows().saturating_sub(self.screen().physical_rows) as i64;
+        let current = self.screen.alt_screen_is_active;
+        let mut roots = HashSet::new();
+        let mut free_data = false;
+        for (key,r) in &self.kitty_img.prototype_records {
+            let left = r["column"].as_i64().unwrap_or(0);
+            let top = r["row"].as_i64().unwrap_or(0);
+            let width = r["columns"].as_i64().unwrap_or(1).max(1);
+            let height = r["rows"].as_i64().unwrap_or(1).max(1);
+            let z = r["zIndex"].as_i64().unwrap_or(0);
+            let col_hit = |x:i64| x >= left && x < left+width;
+            let row_hit = |y:i64| y >= top && y < top+height;
+            let active = self.kitty_img.prototype_placement_buffers.get(key) == Some(&current);
+            let geometric = !matches!(&what,KittyImageDelete::ByImageId{..}|KittyImageDelete::ByImageNumber{..}|KittyImageDelete::ByImageIdRange{..});
+            if geometric && r["isVirtual"].as_bool() == Some(true) { continue; }
+            let hit = match &what {
+                KittyImageDelete::ByImageIdRange{min_id,max_id,delete} => {free_data=*delete;key.0>=(*min_id).min(*max_id) && key.0<=(*min_id).max(*max_id)},
+                KittyImageDelete::ByImageId{image_id,placement_id,delete} => {free_data=*delete;key.0 == *image_id && (placement_id.is_none() || key.1 == *placement_id)},
+                KittyImageDelete::ByImageNumber{image_number,placement_id,delete} => {free_data=*delete;self.kitty_img.number_to_id.get(image_number)==Some(&key.0) && (placement_id.is_none() || key.1 == *placement_id)},
+                KittyImageDelete::All{delete} => {free_data=*delete; active && left < self.screen().physical_cols as i64 && left+width > 0 && top < history+self.screen().physical_rows as i64 && top+height > history},
+                KittyImageDelete::AtCursorPosition{delete} => {free_data=*delete;active && col_hit(self.cursor.x as i64) && row_hit(history+self.cursor.y)},
+                KittyImageDelete::DeleteAt{x,y,delete} => {free_data=*delete;active && col_hit(*x as i64-1) && row_hit(history+*y as i64-1)},
+                KittyImageDelete::DeleteAtZ{x,y,z:level,delete} => {free_data=*delete;active && z == *level as i64 && col_hit(*x as i64-1) && row_hit(history+*y as i64-1)},
+                KittyImageDelete::DeleteColumn{x,delete} => {free_data=*delete;active && col_hit(*x as i64-1)},
+                KittyImageDelete::DeleteRow{y,delete} => {free_data=*delete;active && row_hit(history+*y as i64-1)},
+                KittyImageDelete::DeleteZ{z:level,delete} => {free_data=*delete; z == *level as i64},
+                KittyImageDelete::AnimationFrames{..} => false,
+            };
+            if hit { roots.insert(*key); }
+        }
+        // Uppercase deletion also releases an unplaced cache entry.
+        let extra = match &what {
+            KittyImageDelete::ByImageId{image_id,..} => vec![*image_id],
+            KittyImageDelete::ByImageNumber{image_number,..} => self.kitty_img.number_to_id.get(image_number).copied().into_iter().collect(),
+            KittyImageDelete::ByImageIdRange{min_id,max_id,..} => self.kitty_img.id_to_data.keys().filter(|id|**id>=(*min_id).min(*max_id) && **id<=(*min_id).max(*max_id)).copied().collect(),
+            _ => Vec::new(),
+        };
+        free_data |= match what {
+            KittyImageDelete::ByImageIdRange{delete,..}|KittyImageDelete::ByImageId{delete,..}|KittyImageDelete::ByImageNumber{delete,..}|
+            KittyImageDelete::All{delete}|KittyImageDelete::AtCursorPosition{delete}|
+            KittyImageDelete::DeleteAt{delete,..}|KittyImageDelete::DeleteAtZ{delete,..}|
+            KittyImageDelete::DeleteColumn{delete,..}|KittyImageDelete::DeleteRow{delete,..}|
+            KittyImageDelete::DeleteZ{delete,..}|KittyImageDelete::AnimationFrames{delete} => delete,
+        };
+        self.prototype_delete_keys(roots,free_data,extra);
+    }
+}
