+impl TerminalState {
+    fn prototype_parent_error(&self, image_id: u32, p: &KittyImagePlacement) -> Option<String> {
+        if p.parent_offset_h < i32::MIN as i64 || p.parent_offset_h > i32::MAX as i64
+            || p.parent_offset_v < i32::MIN as i64 || p.parent_offset_v > i32::MAX as i64 {
+            return Some("EINVAL: parent offset out of range".into());
+        }
+        if p.columns.map_or(false,|v|v>2048) || p.rows.map_or(false,|v|v>2048) {
+            return Some("EINVAL: placement dimensions out of range".into());
+        }
+
+        if p.virtual_placement && (p.parent_image_id.is_some() || p.parent_placement_id.is_some()) {
+            return Some("EINVAL: virtual placement cannot refer to parent".into());
+        }
+        if p.parent_image_id.is_some() != p.parent_placement_id.is_some() {
+            return Some("EINVAL: incomplete parent reference".into());
+        }
+        let (parent_image,parent_placement) = match (p.parent_image_id,p.parent_placement_id) {
+            (Some(i),Some(j)) => (i,j), _ => return None,
+        };
+        let parent = (parent_image,Some(parent_placement));
+        if !self.kitty_img.placements.contains_key(&parent) { return Some("ENOPARENT: parent placement not found".into()); }
+        if self.kitty_img.prototype_placement_buffers.get(&parent) != Some(&self.screen.alt_screen_is_active) {
+            return Some("ENOPARENT: parent placement not in current buffer".into());
+        }
+        let child = (image_id,p.placement_id);
+        let mut current = Some(parent);
+        let mut seen = HashSet::new();
+        let mut depth = 0;
+        while let Some(key) = current {
+            if key == child || !seen.insert(key) { return Some("ECYCLE: cyclic placement reference".into()); }
+            depth += 1;
+            if depth > 32 { return Some("ETOODEEP: placement chain limit".into()); }
+            current = self.kitty_img.prototype_records.get(&key).and_then(|r|
+                r["parentImageId"].as_u64().zip(r["parentPlacementId"].as_u64())
+                    .map(|(i,j)|(i as u32,Some(j as u32))));
+        }
+        None
+    }
+
+    fn prototype_parent_position(&self, key: (u32,Option<u32>)) -> anyhow::Result<(i64,i64)> {
+        let mut cursor = key;
+        let mut offset = (0i64,0i64);
+        let mut seen = HashSet::new();
+        loop {
+            anyhow::ensure!(seen.len() <= 32 && seen.insert(cursor), "invalid Kitty parent graph");
+            let r = self.kitty_img.prototype_records.get(&cursor).ok_or_else(||anyhow::anyhow!("missing parent record"))?;
+            if r["isVirtual"].as_bool() == Some(true) {
+                if let Some((row,col)) = self.prototype_virtual_position(cursor) { return Ok((row+offset.0,col+offset.1)); }
+            }
+            if let Some((i,j)) = r["parentImageId"].as_u64().zip(r["parentPlacementId"].as_u64()) {
+                offset.0 += r["parentOffsetV"].as_i64().unwrap_or(0);
+                offset.1 += r["parentOffsetH"].as_i64().unwrap_or(0);
+                cursor = (u32::try_from(i)?,Some(u32::try_from(j)?));
+            } else {
+                let row = r["row"].as_i64().ok_or_else(||anyhow::anyhow!("invalid parent row"))?;
+                let col = r["column"].as_i64().ok_or_else(||anyhow::anyhow!("invalid parent column"))?;
+                return Ok((row+offset.0,col+offset.1));
+            }
+        }
+    }
+
+    fn prototype_delete_keys(&mut self, roots: HashSet<(u32,Option<u32>)>, delete: bool, extra: Vec<u32>) {
+        let mut removed = roots.clone();
+        loop {
+            let mut added = false;
+            for (key,r) in &self.kitty_img.prototype_records {
+                if let Some((i,j)) = r["parentImageId"].as_u64().zip(r["parentPlacementId"].as_u64()) {
+                    if removed.contains(&(i as u32,Some(j as u32))) && removed.insert(*key) { added = true; }
+                }
+            }
+            if !added { break; }
+        }
+        let descendant_images: HashSet<_> = removed.difference(&roots).map(|key|key.0).collect();
+        for (i,p) in &removed {
+            self.kitty_remove_placement(*i,*p);
+            self.kitty_img.prototype_records.remove(&(*i,*p));
+            self.kitty_img.prototype_placement_buffers.remove(&(*i,*p));
+        }
+        let mut free = descendant_images;
+        if delete { free.extend(removed.iter().map(|key|key.0)); free.extend(extra); }
+        for i in free {
+            if !self.kitty_img.placements.keys().any(|key|key.0 == i) { self.kitty_img.remove_data_for_id(i); self.kitty_img.number_to_id.retain(|_,id|*id != i); }
+        }
+    }
+}
