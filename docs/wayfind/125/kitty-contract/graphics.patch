+    fn prototype_transmit_checked(&mut self, transmit: KittyImageTransmit, success: KittyImageVerbosity, failure: KittyImageVerbosity) -> Option<u32> {
+        let id = transmit.image_id; let number = transmit.image_number;
+        if id.is_some() && number.is_some() {
+            self.kitty_send_response(failure,false,id,None,"EINVAL: i and I are mutually exclusive".into());
+            return None;
