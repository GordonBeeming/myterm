+impl BridgeGraphics {
+    fn relative_resource(
+        &mut self,
+        image: &std::sync::Arc<wezterm_surface::change::ImageData>,
+        width: usize,
+        height: usize,
+        request: &BridgeValue,
+    ) -> anyhow::Result<String> {
+        let key = Self::request_key(image.hash(), width, height, Some(request))?;
+        if !self.resources.contains_key(&key) {
+            anyhow::ensure!(
+                self.resources.len() < 32
+                    && (1..=2048).contains(&width)
+                    && (1..=2048).contains(&height),
+                "relative resource limit"
+            );
+            let data = image.data();
+            match &*data {
+                wezterm_cell::image::ImageDataType::Rgba8 {
+                    data,
+                    width: source_width,
+                    height: source_height,
+                    ..
+                } => {
+                    self.decoded_bytes += data.len();
+                    anyhow::ensure!(self.decoded_bytes <= 262144, "checkpoint image byte limit");
+                    self.resources.insert(key.clone(),json!({"key":key,"rgba":data,"encoded":[],"width":source_width,"height":source_height,
+                        "displayWidth":width,"displayHeight":height,"request":request}));
+                }
+                _ => anyhow::bail!("unsupported relative resource"),
+            }
+        }
+        Ok(key)
+    }
+}
