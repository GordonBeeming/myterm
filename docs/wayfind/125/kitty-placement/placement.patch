+
+impl TerminalState {
+    pub(super) fn prototype_update_kitty_records(&mut self) {
+        let mut positions = HashMap::new();
+        let screen = self.screen();
+        let alternate = self.screen.alt_screen_is_active;
+        for (row,line) in screen.lines_in_phys_range(0..screen.scrollback_rows()).iter().enumerate() {
+            for cell in line.visible_cells() {
+                for image in cell.attrs().images().unwrap_or_default() {
+                    if let Some(id) = image.image_id() {
+                        let key = (id,image.placement_id());
+                        if self.kitty_img.prototype_placement_buffers.get(&key) == Some(&alternate) {
+                            positions.entry(key).or_insert((row,cell.cell_index()));
+                        }
+                    }
+                }
+            }
+        }
+        for (key,(row,column)) in positions {
+            if let Some(record) = self.kitty_img.prototype_records.get_mut(&key) {
+                record["row"] = serde_json::json!(row);
+                record["column"] = serde_json::json!(column);
+            }
+        }
+    }
+}
