+    pub(crate) fn prototype_store_image_request(&mut self, hash: [u8;32], width: usize, height: usize, request: BridgeValue) {
+        let mut referenced: std::collections::HashSet<[u8;32]> = self.image_cache.iter().map(|(key,_)|*key).collect();
