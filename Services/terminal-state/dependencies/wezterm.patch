+        if p.virtual_placement && (p.parent_image_id.is_some() || p.parent_placement_id.is_some()) {
+            return Some("EINVAL: virtual placement cannot refer to parent".into());
+        }
+        if p.parent_image_id.is_some() != p.parent_placement_id.is_some() {
+            return Some("EINVAL: incomplete parent reference".into());
+        }
+        let (parent_image, parent_placement) = match (p.parent_image_id, p.parent_placement_id) {
+            (Some(i), Some(j)) => (i, j),
+            _ => return None,
+        };
+        let parent = (parent_image, Some(parent_placement));
+        if !self.kitty_img.placements.contains_key(&parent) {
+            return Some("ENOPARENT: parent placement not found".into());
+        }
+        if self.kitty_img.prototype_placement_buffers.get(&parent)
+            != Some(&self.screen.alt_screen_is_active)
+        {
+            return Some("ENOPARENT: parent placement not in current buffer".into());
+        }
+        let child = (image_id, p.placement_id);
+        let mut current = Some(parent);
+        let mut seen = HashSet::new();
+        let mut depth = 0;
+        while let Some(key) = current {
+            if key == child || !seen.insert(key) {
+                return Some("ECYCLE: cyclic placement reference".into());
+            }
+            depth += 1;
+            if depth > 32 {
+                return Some("ETOODEEP: placement chain limit".into());
+            }
+            current = self.kitty_img.prototype_records.get(&key).and_then(|r| {
+                r["parentImageId"]
+                    .as_u64()
+                    .zip(r["parentPlacementId"].as_u64())
+                    .map(|(i, j)| (i as u32, Some(j as u32)))
+            });
+        }
+        // Replacing a placement retains its descendants on the same screen.
+        // Their new depth includes the ancestors validated above.
+        if self.kitty_img.prototype_placement_buffers.get(&child)
+            == Some(&self.screen.alt_screen_is_active)
+        {
+            let mut children = HashMap::<_, Vec<_>>::new();
+            for (key, record) in &self.kitty_img.prototype_records {
+                if self.kitty_img.prototype_placement_buffers.get(key)
+                    != Some(&self.screen.alt_screen_is_active)
+                {
+                    continue;
+                }
+                if let Some((image, placement)) = record["parentImageId"]
+                    .as_u64()
+                    .zip(record["parentPlacementId"].as_u64())
+                {
+                    children
+                        .entry((image as u32, Some(placement as u32)))
+                        .or_default()
+                        .push(*key);
+                }
+            }
+            let mut pending = vec![(child, depth)];
+            while let Some((key, depth)) = pending.pop() {
+                if !seen.insert(key) {
+                    return Some("ECYCLE: cyclic placement reference".into());
+                }
+                if depth > 32 {
+                    return Some("ETOODEEP: placement chain limit".into());
+                }
+                if let Some(children) = children.get(&key) {
+                    pending.extend(children.iter().map(|child| (*child, depth + 1)));
+                }
+            }
+        }
+        None
+    }
