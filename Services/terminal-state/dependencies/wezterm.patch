+impl BridgeGraphics {
+    fn relative_resource(
+        &mut self,
+        image: &std::sync::Arc<wezterm_surface::change::ImageData>,
+        width: usize,
+        height: usize,
+        request: &BridgeValue,
+        cell_height: usize,
+    ) -> anyhow::Result<String> {
+        let key = Self::request_key(image.hash(), width, height, Some(request))?;
+        if !self.resources.contains_key(&key) {
+            anyhow::ensure!(
+                (1..=65_535).contains(&width) && (1..=65_535).contains(&height),
+                "relative resource limit"
+            );
+            let data = image.data();
+            match &*data {
+                wezterm_cell::image::ImageDataType::Rgba8 {
+                    data,
+                    width: source_width,
+                    height: source_height,
+                    ..
+                } => {
+                    self.reserve((*source_width as usize, *source_height as usize), data.len(),
+                        (width, height), cell_height)?;
+                    let rgba = base64::engine::general_purpose::STANDARD.encode(data);
+                    self.resources.insert(key.clone(),json!({"key":key,"rgba":rgba,"encoded":"","width":source_width,"height":source_height,
+                        "displayWidth":width,"displayHeight":height,"request":request}));
+                }
+                _ => anyhow::bail!("unsupported relative resource"),
+            }
+        }
+        Ok(key)
+    }
+}
