+impl TerminalState {
+    fn prototype_scan_virtual_positions(
+        &self,
+        keys: &HashSet<(u32, Option<u32>)>,
+    ) -> HashMap<(u32, Option<u32>), (i64, i64)> {
+        fn color(c: crate::color::ColorAttribute) -> u32 {
+            use crate::color::ColorAttribute::*;
+            match c {
+                Default => 0,
+                PaletteIndex(i) => i as u32,
+                TrueColorWithPaletteFallback(c, _) | TrueColorWithDefaultFallback(c) => {
+                    let (r, g, b, _) = c.to_srgb_u8();
+                    ((r as u32) << 16) | ((g as u32) << 8) | b as u32
+                }
+            }
+        }
+        let mut result: HashMap<(u32, Option<u32>), (i64, i64)> = HashMap::new();
+        if keys.is_empty() {
+            return result;
+        }
+        let mut by_image: HashMap<u32, Vec<(u32, Option<u32>)>> = HashMap::new();
+        for (key, r) in &self.kitty_img.prototype_records {
+            if r["isVirtual"].as_bool() == Some(true)
+                && self.kitty_img.prototype_placement_buffers.get(key)
+                    == Some(&self.screen.alt_screen_is_active)
+            {
+                by_image.entry(key.0).or_default().push(*key);
+            }
+        }
+        for variants in by_image.values_mut() {
+            variants.sort();
+        }
+        for (row, line) in self
+            .screen()
+            .lines_in_phys_range(0..self.screen().scrollback_rows())
+            .iter()
+            .enumerate()
+        {
+            let mut previous: Option<(usize, usize, usize, u32, u32, u32)> = None;
+            for cell in line.visible_cells() {
+                let col = cell.cell_index();
+                if col >= self.screen().physical_cols {
+                    break;
+                }
+                let mut chars = cell.str().chars();
+                if chars.next() != Some('\u{10eeee}') {
+                    previous = None;
+                    continue;
+                }
+                let marks: Vec<_> = chars
+                    .filter_map(|c| {
+                        PROTOTYPE_KITTY_DIACRITICS
+                            .iter()
+                            .position(|v| *v == c as u32)
+                    })
+                    .collect();
+                let fg = color(cell.attrs().foreground());
+                let ul = color(cell.attrs().underline_color());
+                let adjacent = previous.filter(|p| p.0 + 1 == col && p.4 == fg && p.5 == ul);
+                let pr = marks
+                    .first()
+                    .copied()
+                    .unwrap_or_else(|| adjacent.map_or(0, |p| p.1));
+                let pc = marks
+                    .get(1)
+                    .copied()
+                    .unwrap_or_else(|| adjacent.filter(|p| p.1 == pr).map_or(0, |p| p.2 + 1));
+                let msb = marks
+                    .get(2)
+                    .copied()
+                    .map(|n| n.min(255) as u32)
+                    .unwrap_or_else(|| {
+                        adjacent
+                            .filter(|p| p.1 == pr && (marks.len() < 2 || p.2 + 1 == pc))
+                            .map_or(0, |p| p.3)
+                    });
+                previous = Some((col, pr, pc, msb, fg, ul));
+                let id = fg | (msb << 24);
+                let selected = by_image
+                    .get(&id)
+                    .and_then(|variants| {
+                        variants.iter().find(|key| {
+                            if ul != 0 && key.1 != Some(ul) {
+                                return false;
+                            }
+                            self.kitty_img
+                                .prototype_records
+                                .get(key)
+                                .map_or(false, |r| {
+                                    r["columns"].as_u64().map_or(false, |n| n > pc as u64)
+                                        && r["rows"].as_u64().map_or(false, |n| n > pr as u64)
+                                })
+                        })
+                    })
+                    .copied();
+                if let Some(key) = selected.filter(|key| keys.contains(key)) {
+                    result
+                        .entry(key)
+                        .and_modify(|point| {
+                            point.0 = point.0.min(row as i64);
+                            point.1 = point.1.min(col as i64);
+                        })
+                        .or_insert((row as i64, col as i64));
+                }
+            }
+        }
+        result
+    }
+
+    fn prototype_virtual_position(&self, key: (u32, Option<u32>)) -> Option<(i64, i64)> {
+        self.prototype_scan_virtual_positions(&[key].iter().copied().collect())
+            .get(&key)
+            .copied()
+    }
+}
