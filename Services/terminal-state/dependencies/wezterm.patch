+impl TerminalState {
+    fn prototype_project_relative(
+        &mut self,
+        key: (u32, Option<u32>),
+        desired: (i64, i64),
+        positioned: bool,
+    ) -> anyhow::Result<()> {
+        self.kitty_img.prototype_projection_count =
+            self.kitty_img.prototype_projection_count.wrapping_add(1);
+        use ordered_float::NotNan;
+        use wezterm_cell::image::ImageCell;
+        use wezterm_surface::TextureCoordinate;
+        let (data, width, height) = self
+            .kitty_img
+            .prototype_relative_data
+            .get(&key)
+            .ok_or_else(|| anyhow::anyhow!("missing relative resource"))?
+            .clone();
+        let cw = self.pixel_width / self.screen().physical_cols;
+        let ch = self.pixel_height / self.screen().physical_rows;
+        anyhow::ensure!(
+            cw > 0 && ch > 0 && width > 0 && height > 0 && width <= 2048 && height <= 2048,
+            "relative projection geometry"
+        );
+        let rows = height.div_ceil(ch) as i64;
+        let cols = width.div_ceil(cw) as i64;
+        let record = self
+            .kitty_img
+            .prototype_records
+            .get_mut(&key)
+            .ok_or_else(|| anyhow::anyhow!("missing relative record"))?;
+        record["row"] = desired.0.into();
+        record["column"] = desired.1.into();
+        record["imageRow"] = desired.0.into();
+        record["imageColumn"] = desired.1.into();
+        record["rows"] = rows.into();
+        record["columns"] = cols.into();
+        let z = record["zIndex"].as_i64().unwrap_or(0) as i32;
+        let left = record["pixelOffsetX"].as_u64().unwrap_or(0) as u16;
+        let top = record["pixelOffsetY"].as_u64().unwrap_or(0) as u16;
+        let seqno = self.seqno;
+        let screen = self.screen_mut();
+        for row in 0..screen.scrollback_rows() {
+            for cell in screen.line_mut(row).cells_mut() {
+                cell.attrs_mut().detach_image_with_placement(key.0, key.1);
+            }
+        }
+        if !positioned {
+            return Ok(());
+        }
+        for row in desired.0.max(0)..(desired.0 + rows).min(screen.scrollback_rows() as i64) {
+            for col in desired.1.max(0)..(desired.1 + cols).min(screen.physical_cols as i64) {
+                let x = (col - desired.1) as f32 * cw as f32 / width as f32;
+                let y = (row - desired.0) as f32 * ch as f32 / height as f32;
+                let image = ImageCell::with_z_index(
+                    TextureCoordinate::new(NotNan::new(x)?, NotNan::new(y)?),
+                    TextureCoordinate::new(
+                        NotNan::new(x + cw as f32 / width as f32)?,
+                        NotNan::new(y + ch as f32 / height as f32)?,
+                    ),
+                    Arc::clone(&data),
+                    z,
+                    left,
+                    top,
+                    0,
+                    0,
+                    Some(key.0),
+                    key.1,
+                );
+                let line = screen.line_mut(row as usize);
+                let mut cell = line
+                    .cells_mut()
+                    .get(col as usize)
+                    .cloned()
+                    .unwrap_or_else(wezterm_cell::Cell::blank);
+                cell.attrs_mut().attach_image(Box::new(image));
+                line.set_cell_clearing_image_placements(col as usize, cell, seqno);
+            }
+        }
+        Ok(())
+    }
+}
+
+impl TerminalState {
+    fn prototype_transmit_checked(
+        &mut self,
+        transmit: KittyImageTransmit,
+        success: KittyImageVerbosity,
+        failure: KittyImageVerbosity,
+    ) -> Option<u32> {
+        let id = transmit.image_id;
+        let number = transmit.image_number;
+        if id.is_some() && number.is_some() {
+            self.kitty_send_response(
+                failure,
+                false,
+                id,
+                None,
+                "EINVAL: i and I are mutually exclusive".into(),
+            );
+            return None;
+        }
+        match self.kitty_img_transmit(transmit, success) {
+            Ok(value) => Some(value),
+            Err(error) => {
+                log::debug!("invalid Kitty image: {:#}", error);
+                self.kitty_send_response(failure, false, id, number, "EINVAL: bad payload".into());
+                None
+            }
+        }
+    }
+}
