+fn bridge_attribute(a: &CellAttributes) -> anyhow::Result<BridgeValue> {
+    use crate::{Intensity, Underline};
+    let underline = match a.underline() {
+        Underline::None => 0, Underline::Single => 1,
+        _ => anyhow::bail!("unsupported underline variant"),
+    };
+    let style: u8 = if a.intensity() == Intensity::Bold {1} else {0}
+        | if underline != 0 {2} else {0}
+        | if a.blink() != crate::Blink::None {4} else {0}
+        | if a.reverse() {8} else {0}
+        | if a.invisible() {16} else {0}
+        | if a.intensity() == Intensity::Half {32} else {0}
+        | if a.italic() {64} else {0}
+        | if a.strikethrough() {128} else {0};
+    anyhow::ensure!(!a.overline(), "unsupported overline");
+    anyhow::ensure!(a.hyperlink().map_or(true, |h| h.params().is_empty()), "unsupported hyperlink parameters");
+    Ok(json!({"fg": bridge_color(a.foreground()), "bg": bridge_color(a.background()),
+        "style":style,"underline":underline,
+        "underlineColor":bridge_color(a.underline_color()),
+        "link":a.hyperlink().map(|h|format!(";{}", h.uri()))}))
+}
+
+fn bridge_saved(saved: &Option<SavedCursor>) -> anyhow::Result<BridgeValue> {
+    match saved {
+        None => Ok(BridgeValue::Null),
+        Some(s) => {
+            anyhow::ensure!(s.g0_charset == CharSet::Ascii && s.g1_charset == CharSet::Ascii,
+                "unsupported saved charset");
+            Ok(json!({"x":s.position.x,"y":s.position.y,"wrapNext":s.wrap_next,
+                "origin":s.dec_origin_mode,"pen":bridge_attribute(&s.pen)?,
+                "wrap":s.prototype_wrap,"reverseWrap":s.prototype_reverse_wrap,"margin":s.prototype_margin}))
+        }
+    }
+}
+
+fn bridge_keyboard(screen: &Screen) -> anyhow::Result<BridgeValue> {
+    anyhow::ensure!(screen.keyboard_stack.len() <= 128, "keyboard stack limit");
+    let flags: Vec<u16> = screen.keyboard_stack.iter().map(|encoding| match encoding {
+        KeyboardEncoding::Xterm => Ok(0), KeyboardEncoding::Kitty(flags) => Ok(flags.bits()),
+        _ => Err(anyhow::anyhow!("unsupported keyboard encoding")),
+    }).collect::<anyhow::Result<_>>()?;
+    Ok(json!({"flags":flags.last().copied().unwrap_or(0), "stack":if flags.is_empty() {&flags[..]} else {&flags[..flags.len()-1]}}))
+}
+
+// Match the native checkpoint cell codec and leave its eight MiB metadata reserve.
+const CHECKPOINT_CELL_PAYLOAD_BYTES: usize = 24 * 1024 * 1024;
+const CHECKPOINT_CELL_BUDGET: usize = CHECKPOINT_CELL_PAYLOAD_BYTES / 23;
+
+#[derive(Debug)]
+pub(crate) struct CheckpointCapacity(pub(crate) &'static str);
+
+impl std::fmt::Display for CheckpointCapacity {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.write_str(self.0)
+    }
+}
+
+impl std::error::Error for CheckpointCapacity {}
+
+fn checkpoint_capacity(condition: bool, diagnostic: &'static str) -> anyhow::Result<()> {
+    if condition { Ok(()) } else { Err(CheckpointCapacity(diagnostic).into()) }
+}
+
+#[derive(Default)]
+struct BridgeCells {
+    allocated: usize,
+    packed_bytes: usize,
+    attribute_bytes: usize,
+    attributes: Vec<BridgeValue>,
+    ids: HashMap<String, u32>,
+    previous_attribute: Option<(CellAttributes, u32)>,
+}
+
+impl BridgeCells {
+    fn intern_attribute(&mut self, attribute: &CellAttributes) -> anyhow::Result<u32> {
+        if let Some((previous, id)) = &self.previous_attribute {
+            if previous == attribute {
+                return Ok(*id);
+            }
+        }
+        let value = bridge_attribute(attribute)?;
+        let key = serde_json::to_string(&value)?;
+        let id = match self.ids.get(&key) {
+            Some(id) => *id,
+            None => {
+                self.attribute_bytes += key.len();
+                checkpoint_capacity(self.attribute_bytes <= 8 * 1024 * 1024, "checkpoint attributes exceed 8 MiB")?;
+                let id = u32::try_from(self.attributes.len())?;
+                self.ids.insert(key, id);
+                self.attributes.push(value);
+                id
+            }
+        };
+        self.previous_attribute = Some((attribute.clone(), id));
+        Ok(id)
+    }
+
+    fn line(&mut self, line: &crate::Line, columns: usize) -> anyhow::Result<String> {
+        const HEADER: usize = 13;
+        self.allocated += columns;
+        checkpoint_capacity(self.allocated <= CHECKPOINT_CELL_BUDGET, "checkpoint allocated cell limit")?;
+        let mut bytes = Vec::new();
+        let mut previous: Option<(usize, usize, u16, u32)> = None;
+        for cell in line.visible_cells() {
+            let text = cell.str().as_bytes();
+            let attribute = self.intern_attribute(cell.attrs())?;
+            let column = cell.cell_index();
+            if let Some((offset, prior_column, count, prior_attribute)) = previous {
+                if cell.width() == 1 && prior_attribute == attribute
+                    && prior_column + usize::from(count) == column
+                    && &bytes[offset + HEADER..] == text
+                {
+                    let count = count + 1;
+                    bytes[offset+2..offset+4].copy_from_slice(&count.to_be_bytes());
+                    previous = Some((offset, prior_column, count, attribute));
+                    continue;
+                }
+            }
+            let geometry = (u16::try_from(column)?, u8::try_from(cell.width())?);
+            let offset = bytes.len();
+            self.packed_bytes += HEADER + text.len();
+            checkpoint_capacity(self.packed_bytes <= 24 * 1024 * 1024, "checkpoint encoded cells exceed the byte budget")?;
+            bytes.extend(geometry.0.to_be_bytes());
+            bytes.extend(1u16.to_be_bytes());
+            bytes.extend(attribute.to_be_bytes());
+            bytes.push(geometry.1);
+            bytes.extend(u32::try_from(text.len())?.to_be_bytes());
+            bytes.extend(text);
+            previous = (cell.width() == 1).then_some((offset, column, 1, attribute));
+        }
+        Ok(base64::engine::general_purpose::STANDARD.encode(bytes))
+    }
+}
+
+fn bridge_screen(screen: &Screen, normal: bool, margins: [usize;4], first: usize, scrollback: usize, cells: &mut BridgeCells,
+    graphics: &mut BridgeGraphics, cell_width: usize, cell_height: usize,
+    requests: &std::collections::HashMap<([u8;32],usize,usize),BridgeValue>,
+    kitty_requests: &std::collections::HashMap<(u32,Option<u32>),BridgeValue>) -> anyhow::Result<BridgeValue> {
+    let count = screen.scrollback_rows();
+    anyhow::ensure!(count <= screen.physical_rows + if normal {scrollback} else {0}, "checkpoint line limit");
+    let first_wrapped = if first == 0 {
+        screen.prototype_first_wrapped
+    } else {
+        screen.lines_in_phys_range(first-1..first).first().is_some_and(|line| line.last_cell_was_wrapped())
+    };
+    let lines = screen.lines_in_phys_range(first..count);
+    let mut output = Vec::new();
+    for line in lines {
+        anyhow::ensure!(!line.is_double_width() && !line.is_double_height_top()
+            && !line.is_double_height_bottom(), "unsupported line render mode");
+        let width = line.len().max(screen.physical_cols);
+        // Reflow can leave a blank normal row at its old width. Its styles
+        // and image cells still belong to the line and must survive a checkpoint.
+        anyhow::ensure!(width <= 1000, "checkpoint stored column limit");
+        let packed = cells.line(&line, width)?;
+        output.push(json!({"wrapped":line.last_cell_was_wrapped(),"cells":packed,
+            "width":line.len().max(screen.physical_cols),"images":graphics.row(&line,cell_width,cell_height,requests,kitty_requests)?}));
+    }
+    Ok(json!({"lines":output,"firstWrapped":first_wrapped,"cursor":[screen.prototype_cursor.x, screen.prototype_cursor.y],"saved":bridge_saved(&screen.saved_cursor)?,"margins":margins,
+        "defaultSavedY":screen.prototype_unsaved_y}))
+}
