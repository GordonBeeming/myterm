+                .as_u64()
+                .zip(r["parentPlacementId"].as_u64())
+            {
+                offset.0 += r["parentOffsetV"].as_i64().unwrap_or(0);
+                offset.1 += r["parentOffsetH"].as_i64().unwrap_or(0);
+                cursor = (u32::try_from(i)?, Some(u32::try_from(j)?));
+            } else {
+                let row = r["row"]
+                    .as_i64()
+                    .ok_or_else(|| anyhow::anyhow!("invalid parent row"))?;
+                let col = r["column"]
+                    .as_i64()
+                    .ok_or_else(|| anyhow::anyhow!("invalid parent column"))?;
+                return Ok((row + offset.0, col + offset.1));
+            }
+        }
+    }
+
+    fn prototype_delete_keys(
+        &mut self,
+        roots: HashSet<(u32, Option<u32>)>,
+        delete: bool,
+        extra: Vec<u32>,
+    ) {
+        let mut removed = roots.clone();
+        loop {
+            let mut added = false;
+            for (key, r) in &self.kitty_img.prototype_records {
+                if let Some((i, j)) = r["parentImageId"]
+                    .as_u64()
+                    .zip(r["parentPlacementId"].as_u64())
+                {
+                    if removed.contains(&(i as u32, Some(j as u32))) && removed.insert(*key) {
+                        added = true;
+                    }
+                }
+            }
+            if !added {
+                break;
+            }
+        }
+        let descendant_images: HashSet<_> = removed.difference(&roots).map(|key| key.0).collect();
+        for (i, p) in &removed {
+            self.kitty_remove_placement(*i, *p);
+            self.kitty_img.prototype_records.remove(&(*i, *p));
+            self.kitty_img.prototype_placement_buffers.remove(&(*i, *p));
+        }
+        let mut free = descendant_images;
+        if delete {
+            free.extend(removed.iter().map(|key| key.0));
+            free.extend(extra);
+        }
+        for i in free {
+            if !self.kitty_img.placements.keys().any(|key| key.0 == i) {
+                self.kitty_img.remove_data_for_id(i);
+                self.kitty_img.number_to_id.retain(|_, id| *id != i);
+            }
+        }
+    }
+}
