+    fn prototype_parent_error(&self, image_id: u32, p: &KittyImagePlacement) -> Option<String> {
+        if p.parent_offset_h < i32::MIN as i64
+            || p.parent_offset_h > i32::MAX as i64
+            || p.parent_offset_v < i32::MIN as i64
+            || p.parent_offset_v > i32::MAX as i64
