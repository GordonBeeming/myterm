+impl Terminal {
+    pub fn myterm_checkpoint(&self, sequence: u64) -> anyhow::Result<Vec<u8>> {
+        anyhow::ensure!(!self.prototype_overflow, "checkpoint unfinished-token limit");
+        let p = &self.prototype_pending;
+        if !p.is_empty() {
+            let body = if p.len()>1 && p.last()==Some(&0x1b) && (p.starts_with(b"\x1b]") || p.starts_with(b"\x1bP")) {&p[..p.len()-1]} else {p.as_slice()};
+            let sixel = if body.starts_with(b"\x1bP") {
+                let header = &body[2..];
+                let final_index = header.iter().position(|b| !(0x30..=0x3f).contains(b));
+                final_index.map_or(true, |i| header[i] == b'q' && header[i+1..].iter().all(|b| (0x20..=0x7e).contains(b)))
+            } else { false };
+            let permitted = body[0] >= 0xc2 || body == b"\x1b" || body.starts_with(b"\x1b[") || body.starts_with(b"\x1b]") || sixel;
+            anyhow::ensure!(permitted && body.iter().skip(1).all(|b|*b >= 0x20),
+                "unsupported partial parser token or interleaved control");
+        }
+        let (visible_rows, mut normal_rows) = self.state.checkpoint_normal_rows();
+        loop {
+            let next = self.state.prototype_checkpoint_state(normal_rows);
+            let result = next.and_then(|state| {
+                let value = serde_json::json!({"version":3,"sequence":sequence,"state":state,"pending":p});
+                let mut bytes = CheckpointBytes::default();
+                if let Err(error) = serde_json::to_writer(&mut bytes, &value) {
+                    if bytes.exceeded {
+                        return Err(crate::terminalstate::CheckpointCapacity("checkpoint exceeds 32 MiB").into());
+                    }
+                    return Err(error.into());
+                }
+                Ok(bytes.bytes)
+            });
+            match result {
+                Err(ref error) if normal_rows > visible_rows
+                    && error.is::<crate::terminalstate::CheckpointCapacity>() => {
+                    normal_rows = visible_rows + (normal_rows - visible_rows) / 2;
+                }
+                _ => return result,
+            }
+        }
+    }
+}
+
+#[derive(Default)]
+struct CheckpointBytes {
+    bytes: Vec<u8>,
+    exceeded: bool,
+}
+
+impl std::io::Write for CheckpointBytes {
+    fn write(&mut self, bytes: &[u8]) -> std::io::Result<usize> {
+        const LIMIT: usize = 32 * 1024 * 1024;
+        if bytes.len() > LIMIT - self.bytes.len() {
+            self.exceeded = true;
+            return Err(std::io::Error::other("checkpoint exceeds 32 MiB"));
+        }
+        self.bytes.extend_from_slice(bytes);
+        Ok(bytes.len())
+    }
+
+    fn flush(&mut self) -> std::io::Result<()> {
+        Ok(())
+    }
+}
