MYTERM_PUSH_PUBLIC_URL=https://push.example.com
MYTERM_PUSH_LISTEN=127.0.0.1:8790
MYTERM_PUSH_DATABASE=./data/push-gateway.sqlite3
MYTERM_PUSH_TEAM_ID=YOUR_TEAM_ID
MYTERM_PUSH_BUNDLE_ID=com.gordonbeeming.myterm.companion
MYTERM_PUSH_APP_ATTEST_ENVIRONMENT=production
MYTERM_PUSH_APNS_KEY_ID=YOUR_KEY_ID
MYTERM_PUSH_APNS_KEY_FILE=/run/secrets/AuthKey_KEYID.p8
MYTERM_PUSH_APNS_TOPIC=com.gordonbeeming.myterm.companion
MYTERM_PUSH_APNS_ENVIRONMENT=production
